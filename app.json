{
  "expo": {
    "name": "Jagabans L.A",
    "slug": "ooosum-foods-llc",
    "version": "1.10.4",
    "orientation": "portrait",
    "icon": "./assets/images/jagabans-circle.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/jagabans-circle.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ooosumfoods.jagabansla",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/jagabans-circle.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ooosumfoods.jagabansla"
    },
    "web": {
      "favicon": "./assets/images/jagabans-circle.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28
          }
        }
      ],
      "expo-sharing",
      [
        "react-native-square-in-app-payments/app.plugin.js",
        {
          "merchantIdentifier": "com.ooosumfoods.jagabansla"
        }
      ]
    ],
    "scheme": "jagabansla",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "94e71267-25cb-411f-88e6-37bafccde801"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/94e71267-25cb-411f-88e6-37bafccde801"
    }
  }
}
