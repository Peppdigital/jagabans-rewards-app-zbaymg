{
  "name": "ooosum-foods-llc",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start --clear",
    "dev:lan": "EXPO_NO_TELEMETRY=1 expo start --clear --lan",
    "dev:localhost": "EXPO_NO_TELEMETRY=1 expo start --clear --localhost",
    "dev:tunnel": "EXPO_NO_TELEMETRY=1 expo start --clear --tunnel",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "expo export -p web && npx workbox generateSW workbox-config.js",
    "build:android": "expo prebuild -p android",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
